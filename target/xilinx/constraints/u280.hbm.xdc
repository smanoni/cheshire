# Simone Manoni <s.manoni@unibo.it>
#
# U280 HBM-specific constraints (DRAM controller = Xilinx HBM IP). Loaded by
# impl_sys.tcl when USE_HBM=1. The HBM AXI user clock (clk_75, 75 MHz) is
# generated by the clock wizard and constrained by its own IP constraints.

#######
# HBM #
#######

# HBM user AXI clock period: 75 MHz -> 13.333 ns
set HBM_TCK 13.333

# Limit delay across the SoC<->HBM AXI CDC (hold handled by the gray-code FIFO).
# tclint-disable line-length
set_max_delay -datapath_only \
    -from [get_pins i_hbm_wrapper/i_axi_cdc_hbm/i_axi_cdc_*/i_cdc_fifo_gray_*/*reg*/C] \
    -to [get_pins i_hbm_wrapper/i_axi_cdc_hbm/i_axi_cdc_*/i_cdc_fifo_gray_*/*i_sync/reg*/D] $HBM_TCK
set_max_delay -datapath_only \
    -from [get_pins i_hbm_wrapper/i_axi_cdc_hbm/i_axi_cdc_*/i_cdc_fifo_gray_*/*reg*/C] \
    -to [get_pins i_hbm_wrapper/i_axi_cdc_hbm/i_axi_cdc_*/i_cdc_fifo_gray_*/i_spill_register/spill_register_flushable_i/*reg*/D] $HBM_TCK
# tclint-enable line-length
